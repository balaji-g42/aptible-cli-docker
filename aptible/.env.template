# =================================================
# Aptible Tunnel Service Configuration
# Copy this file to .env and fill in your values.
# =================================================

# --------------------------------------------------
# PostgreSQL Tunnel Configuration
# --------------------------------------------------
# PG1_APP: The name of your Aptible PostgreSQL database handle
PG1_APP="postgresql-db"

# PG1_INTERNAL_PORT: Port that `aptible db:tunnel` binds to INSIDE the container.
#   Must be different from PG1_PUBLIC_PORT.
#   Recommended: 25432
PG1_INTERNAL_PORT=25432

# PG1_PUBLIC_PORT: Port that socat exposes INSIDE the container.
#   This is what your app connects to (e.g. jdbc:postgresql://aptible-cli:54321/db).
#   Must be different from PG1_INTERNAL_PORT.
#   Recommended: 54321
PG1_PUBLIC_PORT=54321

# --------------------------------------------------
# PostgreSQL Tunnel 2 (optional — uncomment to enable)
# --------------------------------------------------
# PG2_APP="postgresql-db2"
# PG2_INTERNAL_PORT=25433   # Must differ from PG2_PUBLIC_PORT
# PG2_PUBLIC_PORT=54322

# --------------------------------------------------
# Redis Tunnel Configuration
# --------------------------------------------------
# REDIS_APP: The name of your Aptible Redis database handle
REDIS_APP="redis-db"

# REDIS_INTERNAL_PORT: Port that `aptible db:tunnel` binds to INSIDE the container.
#   Must be different from REDIS_PUBLIC_PORT.
REDIS_INTERNAL_PORT=51596

# REDIS_PUBLIC_PORT: Port that the TLS proxy exposes INSIDE the container.
#   Must be different from REDIS_INTERNAL_PORT.
REDIS_PUBLIC_PORT=51597

# --------------------------------------------------
# Redis TLS Extra Domains (optional)
# --------------------------------------------------
# Add extra SANs to the Redis TLS certificate (comma-separated).
# Default SANs already included: localhost, 127.0.0.1
# Example: REDIS_TLS_EXTRA_DOMAINS="myservice,myservice.local"
REDIS_TLS_EXTRA_DOMAINS=""

# --------------------------------------------------
# Terminal UI
# --------------------------------------------------
# Port for the ttyd web terminal inside the container (mapped via docker-compose ports).
UI_PORT=3000
